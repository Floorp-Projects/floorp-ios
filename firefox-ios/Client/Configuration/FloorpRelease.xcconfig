#include "Common.xcconfig"
#include "Release.xcconfig"
#include "version.xcconfig"

// Floorp release identity. Xcode and Xcode Cloud use automatic signing for
// this team; certificates and provisioning profiles are never stored here.
FLOORP_DEVELOPMENT_TEAM = DV2U35YBHT
FLOORP_MARKETING_VERSION = 0.2.0
FLOORP_BUILD_NUMBER = 4
// Keep empty until the public listing is live; otherwise Settings exposes a dead rating link.
FLOORP_APP_STORE_ID =
// Team-scoped because the shorter App Group is owned outside this Apple Developer team.
FLOORP_APP_GROUP_IDENTIFIER = group.app.floorp.Floorp.DV2U35YBHT

DEVELOPMENT_TEAM = $(FLOORP_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
PROVISIONING_PROFILE_SPECIFIER =

APP_VERSION = $(FLOORP_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(FLOORP_BUILD_NUMBER)
APP_STORE_ID = $(FLOORP_APP_STORE_ID)

// FloorpRelease omits the remote-notification background mode because APNs is disabled.
INFOPLIST_FILE = Client/FloorpReleaseInfo.plist
MOZ_BUNDLE_DISPLAY_NAME = Floorp
MOZ_BUNDLE_ID = app.floorp.Floorp
MOZ_PRODUCT_NAME = Floorp
MOZ_PUBLIC_URL_SCHEME = floorp
MOZ_INTERNAL_URL_SCHEME = floorp-internal
MOZ_TODAY_WIDGET_SEARCH_DISPLAY_NAME = Floorp - Search

// Keep cloud features disabled until Floorp owns or is explicitly authorized
// to use their production services. Apple Intelligence summarization remains
// available because it is evaluated independently at runtime.
MOZ_ALLOW_HOSTED_SUMMARIZER = NO
MOZ_ALLOW_QUICK_ANSWERS = NO
MOZ_ALLOW_REMOTE_PUSH_NOTIFICATIONS = NO
// Todo 19 ships the capability fail-closed. Todo 20 may override these only
// from a validated, worktree-external G1-G5 build configuration.
FLOORP_NOTES_SYNC_BUILD_MODE = release-disabled
FLOORP_NOTES_SYNC_SOURCE_SHA =
FLOORP_NOTES_SYNC_REQUESTED = NO
FLOORP_NOTES_SYNC_EFFECTIVE = NO
FLOORP_NOTES_SYNC_FXA_SERVER = release
FLOORP_NOTES_SYNC_ENDPOINT_AUTHORITY = production
FLOORP_NOTES_SYNC_PROTOCOL = sync15
FLOORP_NOTES_SYNC_CUSTOM_FXA_OVERRIDE = NO
FLOORP_NOTES_SYNC_CUSTOM_TOKEN_SERVER_OVERRIDE = NO
FLOORP_NOTES_SYNC_ALLOWED_HOSTS =
FLOORP_NOTES_SYNC_ENDPOINT_MATRIX_SHA256 =
FLOORP_NOTES_SYNC_EVIDENCE_DIGEST =
FLOORP_NOTES_SYNC_EVIDENCE_RESOURCE =
FLOORP_NOTES_SYNC_EVIDENCE_RESOURCE_SHA256 =

CHANNEL = release
OTHER_SWIFT_FLAGS = $(OTHER_SWIFT_FLAGS_common) -DMOZ_CHANNEL_release
OTHER_LDFLAGS = -ObjC -Xlinker -no_application_extension

INCLUDE_SETTINGS_BUNDLE = NO
ENABLE_TESTABILITY = NO
ENABLE_NS_ASSERTIONS = NO
ENABLE_CODE_COVERAGE = NO
CLANG_ENABLE_CODE_COVERAGE = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
DEAD_CODE_STRIPPING = YES
STRIP_INSTALLED_PRODUCT = YES
