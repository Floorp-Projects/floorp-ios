    "Floorp.PanelRegistry.DeleteWebPanelMessage.v1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@” will be permanently removed from the sidebar." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "「%@」はサイドバーから完全に削除されます。" } }
      }
