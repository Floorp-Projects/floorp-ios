    "Floorp.PanelRegistry.RemoveBuiltInMessage.v1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Removing this panel does not delete its data. You can restore “%@” later from Manage Panels." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このパネルを削除してもデータは削除されません。「%@」は後で［パネルを管理］から復元できます。" } }
      }
    },
    "Floorp.PanelRegistry.DeleteWebPanelTitle.v1" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Web Panel?" } },
