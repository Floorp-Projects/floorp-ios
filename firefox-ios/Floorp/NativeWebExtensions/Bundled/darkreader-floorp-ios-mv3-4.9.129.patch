+                } catch (reason) {
+                    const error = asError(reason);
+                    if (
+                        !UNKNOWN_ERROR.test(error.message) ||
+                        attempt >= retryDelays.length
+                    ) {
+                        throw error;
+                    }
+                    await delay(retryDelays[attempt++]);
+                }
+            }
+        }
+
+        function createRecoveringQueue() {
+            let tail = Promise.resolve();
