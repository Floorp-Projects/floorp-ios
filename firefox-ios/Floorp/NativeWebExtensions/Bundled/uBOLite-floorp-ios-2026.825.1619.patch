+        } catch(reason) {
+            lastError = reason;
+            ubolErr(`reconcileSafariContentScripts/${attempt}/${reason}`);
+            if ( attempt < 3 ) {
+                await new Promise(resolve => {
+                    setTimeout(resolve, 50 * attempt);
+                });
+            }
+        }
+    }
+    throw lastError;
+}
