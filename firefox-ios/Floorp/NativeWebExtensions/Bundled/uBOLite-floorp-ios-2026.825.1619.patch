+        // uses an unanchored bare-domain urlFilter. It is not an exact request
+        // hostname exclusion and can suppress unrelated blocking rules.
+        if ( hasUnsafeExcludedRequestDomains ) {
+            rejectedRules.push(rule);
+            continue;
+        }
