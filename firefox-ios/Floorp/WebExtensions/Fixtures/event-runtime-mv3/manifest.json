{
  "manifest_version": 3,
  "name": "Floorp Stage 2 Event Runtime Fixture",
  "version": "1.0.0",
  "permissions": ["alarms", "storage"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Event Runtime",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
