{
  "manifest_version": 3,
  "name": "Floorp Stage 3 Demanding MV3 Fixture",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*.fixture.test/*",
    "https://*.fixture.test/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*.fixture.test/*", "https://*.fixture.test/*"],
      "js": ["content/document-start.js"],
      "css": ["content/cosmetic.css"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.fixture.test/*"],
      "js": ["content/page-world.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "large-static",
        "enabled": true,
        "path": "rules/static.json"
      }
    ]
  }
}
