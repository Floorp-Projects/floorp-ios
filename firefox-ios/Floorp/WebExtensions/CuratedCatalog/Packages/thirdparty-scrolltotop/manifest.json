{
  "manifest_version": 3,
  "name": "Scroll To Top — Floorp compatibility build",
  "version": "1.0.0",
  "host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["content/scroll.js"],
    "css": ["content/scroll.css"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }]
}
