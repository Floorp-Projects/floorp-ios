{
  "manifest_version": 3,
  "name": "ekill — Floorp compatibility build",
  "version": "1.9.0",
  "host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["content/ekill.js"],
    "css": ["content/ekill.css"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }]
}
