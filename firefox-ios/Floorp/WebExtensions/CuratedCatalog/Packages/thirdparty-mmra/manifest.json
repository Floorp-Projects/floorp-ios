{
  "manifest_version": 3,
  "name": "Medium Reading Layout — Floorp compatibility build",
  "version": "1.5.1",
  "host_permissions": ["https://medium.com/*"],
  "content_scripts": [{
    "matches": ["https://medium.com/*"],
    "css": ["content/reading.css"],
    "js": ["content/reading.js"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }]
}
