{
  "manifest_version": 3,
  "name": "Enhanced GitHub — Floorp compatibility build",
  "version": "1.0.0",
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content/enhanced.js"],
    "css": ["content/enhanced.css"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }]
}
