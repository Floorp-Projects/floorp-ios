{
  "manifest_version": 3,
  "name": "Floorp Site Appearance",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["content/appearance.js"],
    "css": ["content/appearance.css"],
    "run_at": "document_start",
    "world": "ISOLATED"
  }]
}
