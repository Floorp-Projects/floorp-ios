{
  "manifest_version": 3,
  "name": "GitHub Dashboard Filter — Floorp compatibility build",
  "version": "0.8.8",
  "host_permissions": ["https://github.com/", "https://github.com/orgs/*/dashboard"],
  "content_scripts": [{
    "matches": ["https://github.com/", "https://github.com/orgs/*/dashboard"],
    "js": ["content/dashboard.js"],
    "css": ["content/dashboard.css"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }]
}
