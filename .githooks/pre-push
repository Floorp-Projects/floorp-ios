#!/usr/bin/env bash

set -euo pipefail

readonly PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REMOTE_NAME="${1:-origin}"
readonly ZERO_SHA="0000000000000000000000000000000000000000"

swiftlint_bin="$(command -v swiftlint || true)"
if [[ -z "${swiftlint_bin}" ]]; then
    echo "SwiftLint is required. Install it with: brew install swiftlint" >&2
    exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "${local_sha}" == "${ZERO_SHA}" ]]; then
        continue
    fi

    if [[ "${remote_ref}" == "refs/heads/main" ]]; then
        echo "Direct pushes to main are disabled. Push a branch and open a pull request." >&2
        exit 1
    fi

    base_sha="${remote_sha}"
    if [[ "${base_sha}" == "${ZERO_SHA}" ]]; then
        base_sha="$(git merge-base "${local_sha}" "refs/remotes/${REMOTE_NAME}/main" 2>/dev/null || true)"
    fi

    "${PROJECT_ROOT}/scripts/ci/lint-changed-swift.sh" "${swiftlint_bin}" "${base_sha}" "${local_sha}"
done
